<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External storage (public) — for sharing CSV/PDF files -->
    <external-path name="external_files" path="." />
    <!-- App-internal cache — for temp files during share -->
    <cache-path name="cache_files" path="." />
    <!-- App Documents directory — for encrypted backup & CSV export -->
    <files-path name="app_documents" path="." />
    <!-- External cache — fallback for share intents -->
    <external-cache-path name="external_cache" path="." />
</paths>