{
    "name": "masarifi-app",
    "private": true,
    "version": "23.0.6",
    "description": "مصاريفي - المدير المالي الشخصي الذكي",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:security": "node scripts/security-scan.mjs",
        "lint": "eslint .",
        "check:all": "tsc --noEmit && eslint . && vitest run && node scripts/guardian.mjs validate",
        "ci:check": "npm run test:coverage && npm run test:security && npm run lint && npm run build",
        "i18n:stats": "node scripts/i18n-sync.mjs",
        "i18n:export": "node scripts/i18n-sync.mjs --export",
        "i18n:import": "node scripts/i18n-sync.mjs --import",
        "i18n:validate": "node scripts/guardian.mjs validate",
        "release": "node scripts/release.mjs",
        "package:clean": "node scripts/package-clean-source.mjs",
        "audit:security": "npm audit --omit=dev --audit-level=high"
    },
    "dependencies": {
        "@capacitor-community/speech-recognition": "^7.0.1",
        "@capacitor-firebase/crashlytics": "^8.2.0",
        "@capacitor/android": "^8.3.1",
        "@capacitor/app": "^8.1.0",
        "@capacitor/browser": "^8.0.3",
        "@capacitor/camera": "^8.2.0",
        "@capacitor/cli": "^8.3.1",
        "@capacitor/core": "^8.3.1",
        "@capacitor/device": "^8.0.2",
        "@capacitor/filesystem": "^8.1.2",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.3.1",
        "@capacitor/local-notifications": "^8.0.2",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/push-notifications": "^8.0.3",
        "@capacitor/share": "^8.0.1",
        "@capgo/capacitor-native-biometric": "^8.4.2",
        "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/manrope": "^5.2.8",
        "@fontsource/tajawal": "^5.2.7",
        "@ionic/pwa-elements": "^3.4.0",
        "canvas-confetti": "^1.9.4",
        "chart.js": "^4.4.9",
        "dexie": "^4.4.2",
        "dexie-react-hooks": "^4.4.0",
        "dompurify": "^3.4.1",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.7",
        "localforage": "^1.10.0",
        "material-symbols": "^0.44.4",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-router-dom": "^7.15.0",
        "sortablejs": "^1.15.7",
        "tesseract.js": "^7.0.0",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.6.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^4.1.11",
        "archiver": "^7.0.1",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^6.3.2",
        "vitest": "^4.1.5"
    }
}
